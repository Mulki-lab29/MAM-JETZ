<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".sipeka.InputPanenActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Input Data Panen"
            android:textColor="#2563EB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Masukkan data berat panen harian dan kondisi lahan kebun."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Berat Hasil Panen (Kg)"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBeratPanen"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Contoh: 3000"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kondisi Lahan Kebun"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etKondisiLahan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Contoh: Lahan Sulit / Flat"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSimpanPanen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="#2563EB"
            android:text="Simpan &amp; Hitung Premi"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>