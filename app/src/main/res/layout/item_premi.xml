<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#EEF2FF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTanggalLahan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14 JULI 2026 • Lahan Sulit"
        android:textColor="#2563EB"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNominalPremi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rp 1.780.000"
        android:textColor="#1E293B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTotalPanen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Total Panen: 5.000,00 Kg"
        android:textColor="#64748B"
        android:textSize="13sp" />
</LinearLayout>